# 复制本文件为 deploy/site.env，按需修改。
# site.env 已在 .gitignore 里，不会提交到仓库 —— 域名/服务器 IP 这类信息留在本地即可。
#
# 用法：
#     cp deploy/site.env.example deploy/site.env
#     编辑 deploy/site.env
#     bash deploy/install.sh

# 必填：主域名
DOMAIN=api.example.com

# 选填：别名域名，会一起写进 server_name（留空则不启用）
DOMAIN_ALT=

# 选填：服务器公网 IP，用于自签证书的 IP SAN。
#       留空时 install.sh 会自动探测（探测失败则证书不含 IP SAN）
SERVER_IP=

# 选填：Python 进程端口，默认 8899。注意别和机器上已有服务冲突（ss -lntp 可查）
PORT=8899
